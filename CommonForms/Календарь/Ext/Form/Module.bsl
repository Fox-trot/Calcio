Процедура КомандаНовостиОбновить(Команда)
	НовостиОбновитьНаСервере();
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовостьПровестиНаСервере(Ссылка)
	Если ЗначениеЗаполнено(Ссылка) И НЕ Ссылка.Проведен Тогда
		Попытка
			Док	= Ссылка.ПолучитьОбъект();
			Док.Записать(РежимЗаписиДокумента.Проведение);
			Возврат Истина
		Исключение
			ОбщегоНазначения.СообщитьОбОшибке(ОписаниеОшибки(),, Ссылка);
		КонецПопытки;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура НовостьПровести() Экспорт
	Если НовостьПровестиНаСервере(НовостьТекущая) Тогда
		Элементы.Новости.Обновить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НовостиПриАктивизацииСтроки(Элемент)
	Если Элементы.Новости.ТекущиеДанные = Неопределено Тогда
		Если ЗначениеЗаполнено(НовостьТекущая) Тогда
			НовостьТекущая	= Неопределено;
			Комментарий = "";
		КонецЕсли;
	Иначе
		Если Элементы.Новости.ТекущиеДанные.Свойство("Ссылка") Тогда
			Комментарий = Элементы.Новости.ТекущиеДанные.Комментарий;
		Иначе
			Комментарий = "";
		КонецЕсли;
		Если Элементы.Новости.ТекущиеДанные.Свойство("Ссылка") Тогда
			НовостьТекущая	= Элементы.Новости.ТекущиеДанные.Ссылка;
			Если Элементы.Новости.ТекущиеДанные.Свойство("Проведен")
			И НЕ Элементы.Новости.ТекущиеДанные.Проведен
			Тогда
				ПодключитьОбработчикОжидания("НовостьПровести", 3, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовостьУдалитьНаСервере(Ссылка)
	Ответ = Ложь;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.Новости") Тогда
		Попытка
			Док = Ссылка.ПолучитьОбъект();
			Док.УстановитьПометкуУдаления(Истина);
			Ответ = Истина;
		Исключение КонецПопытки;
	ИначеЕсли ТипЗнч(Ссылка) = Тип("Массив") Тогда
		Для Каждого Документ Из Ссылка Цикл
			Ответ = Макс(Ответ, НовостьУдалитьНаСервере(Документ));
		КонецЦикла;
	КонецЕсли;
	Возврат Ответ;
КонецФункции

&НаКлиенте
Процедура НовостьУдалить()
	Если Элементы.Новости.ТекущиеДанные <> Неопределено
	И Элементы.Новости.ТекущиеДанные.Свойство("Ссылка")
	Тогда
		НовостьТекущая	= Неопределено;
		Комментарий		= "";
		Если Элементы.Новости.ВыделенныеСтроки.Количество() = 1 Тогда
			Если НовостьУдалитьНаСервере(Элементы.Новости.ТекущиеДанные.Ссылка) Тогда
				Элементы.Новости.Обновить();
			КонецЕсли;
		Иначе
			Результат = Новый Массив;
			Для Каждого Проверка Из Элементы.Новости.ВыделенныеСтроки Цикл
				ДанныеПроверки = Элементы.Новости.ДанныеСтроки(Проверка);
				Если ДанныеПроверки = Неопределено Тогда
					//
				ИначеЕсли Результат.Найти(ДанныеПроверки.Ссылка) = Неопределено Тогда
					Результат.Добавить(ДанныеПроверки.Ссылка);
				КонецЕсли;
			КонецЦикла;
			Если НовостьУдалитьНаСервере(Результат) Тогда
				Элементы.Новости.Обновить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаУдалить(Команда)
	НовостьУдалить();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВМассивДобавить(Масса, Элемент)
	Если Масса.Найти(Элемент) = Неопределено Тогда
		Масса.Добавить(Элемент);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура КомандыНайти(Запрос, Знач Наименование)
	Если ЗначениеЗаполнено(Запрос.Параметры.Чемпионат) Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЧемпионатыКоманды.Команда КАК Команда,
		               |	ЧемпионатыКоманды.Команда.Наименование ПОДОБНО &Комментарий КАК Пометка
		               |ИЗ
		               |	Справочник.Чемпионаты.Команды КАК ЧемпионатыКоманды
		               |ГДЕ
		               |	ЧемпионатыКоманды.Ссылка = &Чемпионат
		               |	И (ЧемпионатыКоманды.Команда.Наименование ПОДОБНО &Комментарий
		               |			ИЛИ ЧемпионатыКоманды.Команда.Комментарий ПОДОБНО &Комментарий)
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Пометка УБЫВ";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	МатчКоманды.Команда КАК Команда,
		               |	МатчКоманды.Команда.Наименование ПОДОБНО &Комментарий КАК Пометка
		               |ИЗ
		               |	Документ.Матч.Команды КАК МатчКоманды
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Матч КАК Матч
		               |		ПО МатчКоманды.Ссылка = Матч.Ссылка
		               |ГДЕ
		               |	Матч.Дата МЕЖДУ &ДатаН И &ДатаК
		               |	И Матч.ПометкаУдаления = ЛОЖЬ
		               |	И (МатчКоманды.Команда.Наименование ПОДОБНО &Комментарий
		               |			ИЛИ МатчКоманды.Команда.Комментарий ПОДОБНО &Комментарий)
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Пометка УБЫВ";
	КонецЕсли;
	Наименование	= СтрЗаменить(Наименование, " - ", " = ");
	Клуб		= "";
	Слова		= Разделить(Наименование);
	ЕстьСчет	= (СтрНайти(Наименование, "=") > 0 И СтрЧислоВхождений(Наименование, ":") > 1);
	Для Каждого Слово Из Слова Цикл
		Если ЕстьСчет Тогда
			Если СтрСравнить(Слово, "=") = 0 Тогда
				Клуб = "";
				Продолжить;
			ИначеЕсли СтрНайти(Слово, ":") > 0 Тогда
				Прервать;
			ИначеЕсли ПустаяСтрока(Клуб) Тогда
				Клуб = Слово;
			Иначе
				Клуб = Клуб + " " + Слово;
			КонецЕсли;
			Запрос.УстановитьПараметр("Комментарий",			Обернуть(Клуб));
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ВМассивДобавить(Запрос.Параметры.Команды, Выборка.Команда);
			КонецЕсли;
		ИначеЕсли СтрНайти(Слово, """") > 0 Тогда
			Запрос.УстановитьПараметр("Комментарий",			Обернуть(Лев(СтрУдалить(Слово, """"), 5)));
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ВМассивДобавить(Запрос.Параметры.Команды, Выборка.Команда);
				Пометка = Выборка.Пометка;
				Пока Выборка.Следующий() И Выборка.Пометка = Пометка Цикл
					ВМассивДобавить(Запрос.Параметры.Команды, Выборка.Команда);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция МатчПолучить(Комментарий)
	Уникум = СтрПолучитьСтроку(Комментарий, СтрЧислоСтрок(Комментарий));
	Если СтрДлина(Уникум) = 36 Тогда
		Попытка
			Ответ = Документы.Матч.ПолучитьСсылку(Новый УникальныйИдентификатор(Уникум));
			Если ЗначениеЗаполнено(Ответ.Дата) Тогда
				Возврат Ответ;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат Документы.Матч.ПустаяСсылка();
КонецФункции

&НаСервереБезКонтекста
Функция СсылкаПодобрать(Ссылка)
	Ответ = Неопределено;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.Новости") Тогда
		Ответ	= МатчПолучить(Ссылка.Комментарий);
		Если ЗначениеЗаполнено(Ответ) Тогда
			Возврат Ответ;
		КонецЕсли;
		ЧислоСтрок	= СтрЧислоСтрок(Ссылка.Комментарий);
		Комментарий = СтрУдалить(Ссылка.Комментарий, Разделить(". ,"));
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДатаН",				Ссылка.Дата - Сутки(7));
		Запрос.УстановитьПараметр("ДатаК",				Ссылка.Дата + Сутки());
		Запрос.УстановитьПараметр("Чемпионат",			Неопределено);
		Запрос.УстановитьПараметр("Команды",			Новый Массив);
		Для НомерСтроки = 1 По ЧислоСтрок Цикл
			Если ЗначениеЗаполнено(Ответ) Тогда Прервать; КонецЕсли;
			Наименование = СтрПолучитьСтроку(Комментарий, НомерСтроки);
			Слова = Разделить(Наименование);
			Если Слова.Количество() = 0 Тогда
				//
			ИначеЕсли ЗначениеЗаполнено(Запрос.Параметры.Чемпионат) Тогда
				КомандыНайти(Запрос, Наименование);
			Иначе
				Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				               |	Чемпионаты.Ссылка КАК Ссылка
				               |ИЗ
				               |	Справочник.Чемпионаты КАК Чемпионаты
				               |ГДЕ
				               |	Чемпионаты.ПометкаУдаления = ЛОЖЬ
				               |	И &ДатаН МЕЖДУ Чемпионаты.ДатаНачала И Чемпионаты.ДатаОкончания
				               |	И (Чемпионаты.Наименование ПОДОБНО &Комментарий
				               |			ИЛИ Чемпионаты.Комментарий ПОДОБНО &Комментарий)
				               |
				               |УПОРЯДОЧИТЬ ПО
				               |	Чемпионаты.ДатаОкончания УБЫВ";
				Если Слова.Количество() = 1 Тогда
					Запрос.УстановитьПараметр("Комментарий",			Обернуть(Слова.Получить(0)));
				Иначе
					Запрос.УстановитьПараметр("Комментарий",			Обернуть(Слова.Получить(0) + "%" + Слова.Получить(1)));
				КонецЕсли;
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Запрос.УстановитьПараметр("Чемпионат",				Выборка.Ссылка);
					КомандыНайти(Запрос, Наименование);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		КомандыНайти(Запрос, Ссылка.Наименование);
		Если Запрос.Параметры.Команды.Количество() > 0 Тогда
			Если ЗначениеЗаполнено(Запрос.Параметры.Чемпионат) Тогда
				Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
				               |	МатчКоманды.Ссылка КАК Ссылка,
				               |	Матч.Дата КАК Дата
				               |ИЗ
				               |	Документ.Матч.Команды КАК МатчКоманды
				               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Матч КАК Матч
				               |		ПО МатчКоманды.Ссылка = Матч.Ссылка
				               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Матч.Команды КАК Противники
				               |		ПО МатчКоманды.Ссылка = Противники.Ссылка
				               |			И МатчКоманды.Команда <> Противники.Команда
				               |ГДЕ
				               |	Матч.Дата МЕЖДУ &ДатаН И &ДатаК
				               |	И Матч.ПометкаУдаления = ЛОЖЬ
				               |	И Матч.Тур.Владелец = &Чемпионат
				               |	И МатчКоманды.Команда В(&Команды)
				               |	И Противники.Команда В(&Команды)
				               |
				               |УПОРЯДОЧИТЬ ПО
				               |	Дата УБЫВ";
			Иначе
				Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
				               |	Матч.Ссылка КАК Ссылка
				               |ИЗ
				               |	Документ.Матч.Команды КАК МатчКоманды
				               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Матч КАК Матч
				               |		ПО МатчКоманды.Ссылка = Матч.Ссылка
				               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Матч.Команды КАК Противники
				               |		ПО МатчКоманды.Ссылка = Противники.Ссылка
				               |			И МатчКоманды.Команда <> Противники.Команда
				               |ГДЕ
				               |	Матч.Дата МЕЖДУ &ДатаН И &ДатаК
				               |	И Матч.ПометкаУдаления = ЛОЖЬ
				               |	И МатчКоманды.Команда В(&Команды)
				               |	И Противники.Команда В(&Команды)
				               |
				               |УПОРЯДОЧИТЬ ПО
				               |	Матч.Дата УБЫВ";
			КонецЕсли;
			Если Запрос.Параметры.Команды.Количество() = 1 Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Противники.Команда В(&Команды)", "");
			КонецЕсли;
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Ответ = Выборка.Ссылка;
				Если Выборка.Количество() = 1 Тогда
					Попытка
						Док = Ссылка.ПолучитьОбъект();
						Если СтрНайти(Док.Комментарий, Выборка.Ссылка.УникальныйИдентификатор()) = 0 Тогда
							Док.Комментарий	= Док.Комментарий + Разрыв() + Выборка.Ссылка.УникальныйИдентификатор();
							Док.Записать(РежимЗаписиДокумента.Запись);
						КонецЕсли;
					Исключение КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Ответ;
КонецФункции

&НаКлиенте
Процедура НовостиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Показать(СсылкаПодобрать(ВыбраннаяСтрока), СтандартнаяОбработка);
	Если СтандартнаяОбработка Тогда
		СтандартнаяОбработка = Ложь;
		НовостьПровести();
	КонецЕсли;
КонецПроцедуры

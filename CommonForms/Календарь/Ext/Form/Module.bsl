	Новости.Параметры.УстановитьЗначениеПараметра(ПараметрИмя, Значение);
КонецПроцедуры

&НаСервере
Процедура НовостиОбновитьНаСервере()
	Если Элементы.СтраницаНовости.Видимость Тогда
		Элементы.Период.Подсказка	= Строка(Период);

		НовостиУстановитьЗначениеПараметра("ДатаН",				Период.ДатаНачала);
		НовостиУстановитьЗначениеПараметра("ДатаК",				Период.ДатаОкончания);
		НовостиУстановитьЗначениеПараметра("МояКоманда",		Обернуть(МояКоманда));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НовостиОбновить() Экспорт
	НовостиОбновитьНаСервере();
КонецПроцедуры


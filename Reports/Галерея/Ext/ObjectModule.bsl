
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Игрок) Тогда
		СхемаКомпоновкиДанных	= ПолучитьМакет("СхемаИгрок");
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Игрок",	Игрок);
	ИначеЕсли ЗначениеЗаполнено(Тур) Тогда
		СхемаКомпоновкиДанных	= ПолучитьМакет("СхемаТур");
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Тур",	Тур);
	ИначеЕсли ЗначениеЗаполнено(Чемпионат) Тогда
		СхемаКомпоновкиДанных	= ПолучитьМакет("СхемаЧемпионат");
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Чемпионат",	Чемпионат);
	Иначе
		Настройки = КомпоновщикНастроек.ПолучитьНастройки();
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Команда",	Команда);
		КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ПараметрыФормы = Новый Структура;
	Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.Игроки") Тогда
		ПараметрыФормы.Вставить("Игрок", ПараметрКоманды);
	Иначе
		ПараметрыФормы.Вставить("Команда", ПараметрКоманды);
	КонецЕсли;
	НаКлиенте.ОбработкаКомандыОткрытьФорму("Отчет.Галерея.Форма", ПараметрыФормы, ПараметрыВыполненияКоманды);
КонецПроцедуры

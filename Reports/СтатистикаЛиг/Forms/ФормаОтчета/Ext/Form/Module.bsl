
&НаКлиенте
Процедура ТипГрафикаЗагрузить()
	Если ЗначениеЗаполнено(Отчет.Команда) Тогда
		Если Элементы.ТипГрафика.СписокВыбора.НайтиПоЗначению(23) <> Неопределено
		Или Элементы.ТипГрафика.СписокВыбора.Количество() = 0
		Тогда
			Элементы.ТипГрафика.СписокВыбора.Очистить();
			Элементы.ТипГрафика.СписокВыбора.Добавить(0, "Количество очков");
			Элементы.ТипГрафика.СписокВыбора.Добавить(2, "Количество 'верховых' побед");
			Элементы.ТипГрафика.СписокВыбора.Добавить(3, "Количество 'низовых' побед");
			Элементы.ТипГрафика.СписокВыбора.Добавить(4, "Количество 'сухих' побед");
			
			Элементы.ТипГрафика.СписокВыбора.Добавить(7, "Количество голов забито | пропущено",, БиблиотекаКартинок.Goal);
			
			Элементы.ТипГрафика.СписокВыбора.Добавить(9, "Количество 'верховых' матчей");
			Элементы.ТипГрафика.СписокВыбора.Добавить(10, "Количество 'сухих' матчей");
			Элементы.ТипГрафика.СписокВыбора.Добавить(11, "Разница голов",, БиблиотекаКартинок.Goal);
			
			Элементы.ТипГрафика.СписокВыбора.Добавить(24, "Место в турнирной таблице");
			Элементы.ТипГрафика.СписокВыбора.Добавить(25, "Соотношение очки / матч");
			Элементы.ТипГрафика.СписокВыбора.Добавить(26, "Средняя результативность",, БиблиотекаКартинок.Goal);
			Элементы.ТипГрафика.СписокВыбора.Добавить(27, "Количество голов дома | выезд",, БиблиотекаКартинок.Goal);
			Элементы.ТипГрафика.СписокВыбора.Добавить(28, "Количество побед | ничьих | проигрышей");
			Элементы.ТипГрафика.СписокВыбора.Добавить(29, "Количество 'верховых | низовых' матчей");
			Элементы.ТипГрафика.СписокВыбора.Добавить(30, "Посещаемость");
		КонецЕсли;
	ИначеЕсли Элементы.ТипГрафика.СписокВыбора.НайтиПоЗначению(23) = Неопределено Тогда
		Элементы.ТипГрафика.СписокВыбора.Очистить();
		Элементы.ТипГрафика.СписокВыбора.Добавить(0, "Максимальное количество очков");
		Элементы.ТипГрафика.СписокВыбора.Добавить(1, "Максимальное количество побед");
		Элементы.ТипГрафика.СписокВыбора.Добавить(2, "Максимальное количество 'верховых' побед");
		Элементы.ТипГрафика.СписокВыбора.Добавить(3, "Максимальное количество 'низовых' побед");
		Элементы.ТипГрафика.СписокВыбора.Добавить(4, "Максимальное количество 'сухих' побед");
		Элементы.ТипГрафика.СписокВыбора.Добавить(5, "Максимальное количество ничьих");
		Элементы.ТипГрафика.СписокВыбора.Добавить(6, "Максимальное количество проигрышей");
		Элементы.ТипГрафика.СписокВыбора.Добавить(7, "Максимальное количество голов (забито)",, БиблиотекаКартинок.Goal);
		Элементы.ТипГрафика.СписокВыбора.Добавить(8, "Максимальное количество голов (пропущено)",, БиблиотекаКартинок.Goal);
		Элементы.ТипГрафика.СписокВыбора.Добавить(9, "Максимальное количество 'верховых' матчей");
		Элементы.ТипГрафика.СписокВыбора.Добавить(10, "Максимальное количество 'сухих' матчей");
		Элементы.ТипГрафика.СписокВыбора.Добавить(11, "Лучшая разница голов",, БиблиотекаКартинок.Goal);
		Элементы.ТипГрафика.СписокВыбора.Добавить(12, "Минимальное количество очков");
		Элементы.ТипГрафика.СписокВыбора.Добавить(13, "Минимальное количество побед");
		Элементы.ТипГрафика.СписокВыбора.Добавить(14, "Минимальное количество 'верховых' побед");
		Элементы.ТипГрафика.СписокВыбора.Добавить(15, "Максимальное количество 'низовых' побед");
		Элементы.ТипГрафика.СписокВыбора.Добавить(16, "Максимальное количество 'сухих' побед");
		Элементы.ТипГрафика.СписокВыбора.Добавить(17, "Минимальное количество ничьих");
		Элементы.ТипГрафика.СписокВыбора.Добавить(18, "Минимальное количество проигрышей");
		Элементы.ТипГрафика.СписокВыбора.Добавить(19, "Минимальное количество голов (забито)",, БиблиотекаКартинок.Goal);
		Элементы.ТипГрафика.СписокВыбора.Добавить(20, "Минимальное количество голов (пропущено)",, БиблиотекаКартинок.Goal);
		Элементы.ТипГрафика.СписокВыбора.Добавить(21, "Минимальное количество 'верховых' матчей");
		Элементы.ТипГрафика.СписокВыбора.Добавить(22, "Минимальное количество 'сухих' матчей");
		Элементы.ТипГрафика.СписокВыбора.Добавить(23, "Худшая разница голов",, БиблиотекаКартинок.Goal);
		Элементы.ТипГрафика.СписокВыбора.Добавить(24, "Место в турнирной таблице");
		Элементы.ТипГрафика.СписокВыбора.Добавить(25, "Соотношение очки / матч");
		Элементы.ТипГрафика.СписокВыбора.Добавить(26, "Средняя результативность",, БиблиотекаКартинок.Goal);
		Элементы.ТипГрафика.СписокВыбора.Добавить(27, "Количество голов дома | выезд",, БиблиотекаКартинок.Goal);
		Элементы.ТипГрафика.СписокВыбора.Добавить(28, "Количество побед | ничьих");
		Элементы.ТипГрафика.СписокВыбора.Добавить(29, "Количество 'верховых | низовых' матчей");
		Элементы.ТипГрафика.СписокВыбора.Добавить(30, "Посещаемость");
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция Цвет(Команда)
	Возврат СерверныйФункции.ЦветКоманды(Команда);
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеПолучить(ТипГрафика, Лига, Команда)
	Запрос	= Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 11
	      	               |	ТурнирнаяТаблица.Тур.Владелец КАК Чемпионат,
	      	               |	ГОД(ТурнирнаяТаблица.Тур.Владелец.ДатаОкончания) КАК Точка
	      	               |ПОМЕСТИТЬ Чемпионаты
	      	               |ИЗ
	      	               |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
	      	               |ГДЕ
	      	               |	ТурнирнаяТаблица.Тур.Владелец.Владелец = &Лига
	      	               |
	      	               |СГРУППИРОВАТЬ ПО
	      	               |	ТурнирнаяТаблица.Тур.Владелец,
	      	               |	ГОД(ТурнирнаяТаблица.Тур.Владелец.ДатаОкончания)
	      	               |
	      	               |ИМЕЮЩИЕ
	      	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТурнирнаяТаблица.Регистратор) >= ЦЕЛ(0.62 * КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТурнирнаяТаблица.Команда) * (КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТурнирнаяТаблица.Команда) - 1))
	      	               |
	      	               |УПОРЯДОЧИТЬ ПО
	      	               |	МАКСИМУМ(ТурнирнаяТаблица.Период) УБЫВ
	      	               |;
	      	               |
	      	               |////////////////////////////////////////////////////////////////////////////////
	      	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	      	               |	ТурнирнаяТаблица.Тур КАК Тур,
	      	               |	Чемпионаты.Чемпионат КАК Чемпионат,
	      	               |	Чемпионаты.Точка КАК Точка
	      	               |ПОМЕСТИТЬ Туры
	      	               |ИЗ
	      	               |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
	      	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Туры КАК Туры
	      	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Чемпионаты КАК Чемпионаты
	      	               |			ПО Туры.Владелец = Чемпионаты.Чемпионат
	      	               |		ПО ТурнирнаяТаблица.Тур = Туры.Ссылка" + ";
	      	               |
	      	               |////////////////////////////////////////////////////////////////////////////////
						   |");
	Если ТипГрафика = 0 Или ТипГрафика = 12 Тогда
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
		                              |	Туры.Чемпионат КАК Чемпионат,
		                              |	Туры.Точка КАК Точка,
		                              |	ТурнирнаяТаблица.Команда КАК Серия,
		                              |	ТурнирнаяТаблица.Команда = &Команда КАК Пометка,
		                              |	СУММА(ТурнирнаяТаблица.КоличествоОчков) КАК Количество
		                              |ИЗ
		                              |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
		                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Туры КАК Туры
		                              |		ПО ТурнирнаяТаблица.Тур = Туры.Тур
		                              |
		                              |СГРУППИРОВАТЬ ПО
		                              |	ТурнирнаяТаблица.Команда,
		                              |	Туры.Чемпионат,
		                              |	Туры.Точка
		                              |
		                              |УПОРЯДОЧИТЬ ПО
		                              |	Точка,
		                              |	Количество УБЫВ
		                              |ИТОГИ
		                              |	МАКСИМУМ(Точка),
		                              |	МАКСИМУМ(Пометка),
		                              |	СУММА(Количество)
		                              |ПО
		                              |	Чемпионат";
	ИначеЕсли ТипГрафика = 1 Или ТипГрафика = 13 Тогда
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
		                              |	Туры.Чемпионат КАК Чемпионат,
		                              |	Туры.Точка КАК Точка,
		                              |	ТурнирнаяТаблица.Команда КАК Серия,
		                              |	СУММА(1) КАК Количество
		                              |ИЗ
		                              |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
		                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТурнирнаяТаблица КАК Противники
		                              |		ПО ТурнирнаяТаблица.Регистратор = Противники.Регистратор
		                              |			И ТурнирнаяТаблица.НомерСтроки <> Противники.НомерСтроки
		                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Туры КАК Туры
		                              |		ПО ТурнирнаяТаблица.Тур = Туры.Тур
		                              |ГДЕ
		                              |	ТурнирнаяТаблица.КоличествоОчков > Противники.КоличествоОчков
		                              |
		                              |СГРУППИРОВАТЬ ПО
		                              |	ТурнирнаяТаблица.Команда,
		                              |	Туры.Чемпионат,
		                              |	Туры.Точка
		                              |
		                              |УПОРЯДОЧИТЬ ПО
		                              |	Точка,
		                              |	Количество УБЫВ
		                              |ИТОГИ
		                              |	МАКСИМУМ(Точка),
		                              |	СУММА(Количество)
		                              |ПО
		                              |	Чемпионат";
	ИначеЕсли ТипГрафика = 2 Или ТипГрафика = 14 Тогда
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
		                              |	Туры.Чемпионат КАК Чемпионат,
		                              |	Туры.Точка КАК Точка,
		                              |	ТурнирнаяТаблица.Команда КАК Серия,
		                              |	ТурнирнаяТаблица.Команда = &Команда КАК Пометка,
		                              |	СУММА(1) КАК Количество
		                              |ИЗ
		                              |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
		                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТурнирнаяТаблица КАК Противники
		                              |		ПО ТурнирнаяТаблица.Регистратор = Противники.Регистратор
		                              |			И ТурнирнаяТаблица.НомерСтроки <> Противники.НомерСтроки
		                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Туры КАК Туры
		                              |		ПО ТурнирнаяТаблица.Тур = Туры.Тур
		                              |ГДЕ
		                              |	ТурнирнаяТаблица.КоличествоГолов >= 3
		                              |	И ТурнирнаяТаблица.КоличествоОчков > Противники.КоличествоОчков
		                              |
		                              |СГРУППИРОВАТЬ ПО
		                              |	ТурнирнаяТаблица.Команда,
		                              |	Туры.Чемпионат,
		                              |	Туры.Точка
		                              |
		                              |УПОРЯДОЧИТЬ ПО
		                              |	Точка,
		                              |	Количество УБЫВ
		                              |ИТОГИ
		                              |	МАКСИМУМ(Точка),
		                              |	МАКСИМУМ(Пометка),
		                              |	СУММА(Количество)
		                              |ПО
		                              |	Чемпионат";
	ИначеЕсли ТипГрафика = 3 Или ТипГрафика = 15 Тогда
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
		                              |	Туры.Чемпионат КАК Чемпионат,
		                              |	Туры.Точка КАК Точка,
		                              |	ТурнирнаяТаблица.Команда КАК Серия,
		                              |	ТурнирнаяТаблица.Команда = &Команда КАК Пометка,
		                              |	СУММА(1) КАК Количество
		                              |ИЗ
		                              |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
		                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТурнирнаяТаблица КАК Противники
		                              |		ПО ТурнирнаяТаблица.Регистратор = Противники.Регистратор
		                              |			И ТурнирнаяТаблица.НомерСтроки <> Противники.НомерСтроки
		                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Туры КАК Туры
		                              |		ПО ТурнирнаяТаблица.Тур = Туры.Тур
		                              |ГДЕ
		                              |	ТурнирнаяТаблица.КоличествоГолов <= 2
		                              |	И ТурнирнаяТаблица.КоличествоОчков > Противники.КоличествоОчков
		                              |
		                              |СГРУППИРОВАТЬ ПО
		                              |	ТурнирнаяТаблица.Команда,
		                              |	Туры.Чемпионат,
		                              |	Туры.Точка
		                              |
		                              |УПОРЯДОЧИТЬ ПО
		                              |	Точка,
		                              |	Количество УБЫВ
		                              |ИТОГИ
		                              |	МАКСИМУМ(Точка),
		                              |	МАКСИМУМ(Пометка),
		                              |	СУММА(Количество)
		                              |ПО
		                              |	Чемпионат";
	ИначеЕсли ТипГрафика = 4 Или ТипГрафика = 16 Тогда
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
		                              |	Туры.Чемпионат КАК Чемпионат,
		                              |	Туры.Точка КАК Точка,
		                              |	ТурнирнаяТаблица.Команда КАК Серия,
		                              |	ТурнирнаяТаблица.Команда = &Команда КАК Пометка,
		                              |	СУММА(1) КАК Количество
		                              |ИЗ
		                              |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
		                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТурнирнаяТаблица КАК Противники
		                              |		ПО ТурнирнаяТаблица.Регистратор = Противники.Регистратор
		                              |			И ТурнирнаяТаблица.НомерСтроки <> Противники.НомерСтроки
		                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Туры КАК Туры
		                              |		ПО ТурнирнаяТаблица.Тур = Туры.Тур
		                              |ГДЕ
		                              |	ТурнирнаяТаблица.КоличествоОчков > Противники.КоличествоОчков
		                              |	И Противники.КоличествоГолов = 0
		                              |
		                              |СГРУППИРОВАТЬ ПО
		                              |	ТурнирнаяТаблица.Команда,
		                              |	Туры.Чемпионат,
		                              |	Туры.Точка
		                              |
		                              |УПОРЯДОЧИТЬ ПО
		                              |	Точка,
		                              |	Количество УБЫВ
		                              |ИТОГИ
		                              |	МАКСИМУМ(Точка),
		                              |	МАКСИМУМ(Пометка),
		                              |	СУММА(Количество)
		                              |ПО
		                              |	Чемпионат";
	ИначеЕсли ТипГрафика = 5 Или ТипГрафика = 17 Тогда
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
		                              |	Туры.Чемпионат КАК Чемпионат,
		                              |	Туры.Точка КАК Точка,
		                              |	ТурнирнаяТаблица.Команда КАК Серия,
		                              |	СУММА(1) КАК Количество
		                              |ИЗ
		                              |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
		                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТурнирнаяТаблица КАК Противники
		                              |		ПО ТурнирнаяТаблица.Регистратор = Противники.Регистратор
		                              |			И ТурнирнаяТаблица.НомерСтроки <> Противники.НомерСтроки
		                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Туры КАК Туры

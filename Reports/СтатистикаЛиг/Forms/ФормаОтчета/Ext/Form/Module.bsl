		                              |	Туры.Точка КАК Точка,
		                              |	СУММА(ЕСТЬNULL(Матч.КоличествоЗрителей, 0)) КАК КоличествоЗабито,
		                              |	СУММА(ВЫБОР
		                              |			КОГДА Матч.Стадион.КоличествоЗрителей ЕСТЬ NULL
		                              |				ТОГДА ЕСТЬNULL(Стадионы.КоличествоЗрителей, 0)
		                              |			КОГДА Матч.Стадион.КоличествоЗрителей > Матч.КоличествоЗрителей
		                              |				ТОГДА Матч.Стадион.КоличествоЗрителей - Матч.КоличествоЗрителей
		                              |			ИНАЧЕ 0
		                              |		КОНЕЦ) КАК КоличествоПропущено
		                              |ИЗ
		                              |	Туры КАК Туры
		                              |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Матч КАК Матч
		                              |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
		                              |				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Стадионы КАК Стадионы
		                              |				ПО ТурнирнаяТаблица.Команда = Стадионы.Владелец
		                              |			ПО Матч.Ссылка = ТурнирнаяТаблица.Регистратор
		                              |				И (ТурнирнаяТаблица.НомерСтроки = 1)
		                              |		ПО Туры.Тур = Матч.Тур
		                              |
		                              |СГРУППИРОВАТЬ ПО
		                              |	Туры.Чемпионат,
		                              |	Туры.Точка
		                              |
		                              |УПОРЯДОЧИТЬ ПО
		                              |	Точка";
	КонецЕсли;
	Если ЗначениеЗаполнено(Команда) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "11", "21");
	ИначеЕсли ТипГрафика >= 23 Тогда
		//
	ИначеЕсли ТипГрафика >= 12 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Количество УБЫВ", "Количество");
	КонецЕсли;
	Запрос.УстановитьПараметр("Лига",			Лига);
	Запрос.УстановитьПараметр("Команда",		Команда);
	Возврат Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
КонецФункции

&НаСервере
Процедура ГрафикОбновить()
	Отчет.Данные.Очистить();
	График.Очистить();
	Если НЕ ЗначениеЗаполнено(Отчет.Лига) Тогда Возврат; КонецЕсли;
	
	График.ВидПодписей	= ВидПодписейКДиаграмме.Нет;
	График.ОбластьЗаголовка.Текст = ?(Разделить("18 20 23 24").Найти(ФорматЧГ(ТипГрафика)) = Неопределено, "", "Меньше - лучше");
	График.ОбластьЛегенды.Расположение = ?(ЗначениеЗаполнено(Отчет.Команда) И СтрНайти("0,2,3,4,9,10,11,24,25,26", ТипГрафика) > 0, РасположениеЛегендыДиаграммы.Нет, РасположениеЛегендыДиаграммы.Авто);
	График.ОбластьПостроения.ШкалаЗначений.ТекстЗаголовка = ?(ТипГрафика = 30, "Зрители", "");
	Если ТипГрафика >= 27 Тогда
		График.ТипДиаграммы	= ТипДиаграммы.ГистограммаСНакоплением;
		График.ОбластьПостроения.ШкалаЗначений.ШагШкалы = ?(ТипГрафика = 27, 50, ?(ТипГрафика = 28 Или ТипГрафика = 29, 20, 0));
		График.ВидПодписей	= ВидПодписейКДиаграмме.Процент;
	ИначеЕсли ЗначениеЗаполнено(Отчет.Команда)
	И ТипГрафика = 7
	Тогда
		График.ТипДиаграммы	= ТипДиаграммы.ГистограммаСНакоплением;
		График.ОбластьПостроения.ШкалаЗначений.ШагШкалы = 10;
		График.ВидПодписей	= ВидПодписейКДиаграмме.Процент;
	Иначе
		График.ТипДиаграммы	= ТипДиаграммы.Гистограмма;
		График.ОбластьПостроения.ШкалаЗначений.ШагШкалы = ?(ТипГрафика = 25, 0.5, ?(СтрНайти("0,7,8,11,12,19,20,23", ТипГрафика) > 0, 10, 2));
	КонецЕсли;
	
	Чемпионаты	= ДанныеПолучить(ТипГрафика, Отчет.Лига, Отчет.Команда);
	Максимально	= 0;
	Если Чемпионаты.Количество() = 0 Тогда
		Возврат;
	ИначеЕсли ТипГрафика >= 27 Тогда
		Если ТипГрафика = 27 Тогда
			Хозяева	= График.УстановитьСерию("Хозяева");
			Гости	= График.УстановитьСерию("Гости");
		ИначеЕсли ТипГрафика = 28 И ЗначениеЗаполнено(Отчет.Команда) Тогда
			СерверныйФункции.СерииЗаполнить(График);
		ИначеЕсли ТипГрафика = 28 Тогда
			Хозяева	= График.УстановитьСерию("Ничья");
			Гости	= График.УстановитьСерию("Победа");
		ИначеЕсли ТипГрафика = 29 Тогда
			Хозяева	= График.УстановитьСерию("ТБ 2.5");
			Гости	= График.УстановитьСерию("ТМ 2.5");
		Иначе
			Хозяева	= График.УстановитьСерию("Факт");
			Гости	= График.УстановитьСерию("План");
		КонецЕсли;
		Пока Чемпионаты.Следующий() Цикл
			Если График.Точки.Количество() > 0 Тогда
			ИначеЕсли НЕ ЗначениеЗаполнено(Отчет.Команда) Тогда
			ИначеЕсли ТипГрафика = 27 И Чемпионаты.КоличествоЗабито + Чемпионаты.КоличествоПропущено = 0 Тогда Продолжить;
			ИначеЕсли ТипГрафика = 28 И Чемпионаты.КоличествоЗабито + Чемпионаты.КоличествоПропущено + Чемпионаты.Количество = 0 Тогда Продолжить;
			ИначеЕсли ТипГрафика = 29 И Чемпионаты.КоличествоЗабито + Чемпионаты.КоличествоПропущено = 0 Тогда Продолжить;
			ИначеЕсли ТипГрафика = 30 И Чемпионаты.КоличествоЗабито + Чемпионаты.КоличествоПропущено = 0 Тогда Продолжить;
			КонецЕсли;
			Точка = График.УстановитьТочку(ФорматЧГ(Чемпионаты.Точка));
			Точка.Расшифровка = Чемпионаты.Чемпионат;
			Если ТипГрафика = 28 И ЗначениеЗаполнено(Отчет.Команда) Тогда
				График.УстановитьЗначение(Точка, 0, Чемпионаты.КоличествоПропущено);
				График.УстановитьЗначение(Точка, 1, Чемпионаты.Количество);
				График.УстановитьЗначение(Точка, 2, Чемпионаты.КоличествоЗабито);
				
				Максимально = Макс(Максимально, Чемпионаты.КоличествоЗабито + Чемпионаты.КоличествоПропущено + Чемпионаты.Количество);
			Иначе
				График.УстановитьЗначение(Точка, Хозяева, Чемпионаты.КоличествоЗабито);
				График.УстановитьЗначение(Точка, Гости, Чемпионаты.КоличествоПропущено);
				
				Максимально = Макс(Максимально, Чемпионаты.КоличествоЗабито + Чемпионаты.КоличествоПропущено);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ЗначениеЗаполнено(Отчет.Команда)
	И ТипГрафика = 7
	Тогда
		СерверныйФункции.СерииЗаполнить(График, Истина);
		Пока Чемпионаты.Следующий() Цикл
			//Если График.Точки.Количество() = 0 И Чемпионаты.КоличествоЗабито + Чемпионаты.КоличествоПропущено = 0 Тогда Продолжить; КонецЕсли;
			Точка = График.УстановитьТочку(ФорматЧГ(Чемпионаты.Точка));
			Точка.Расшифровка = Чемпионаты.Чемпионат;
			График.УстановитьЗначение(Точка, 0, Чемпионаты.КоличествоЗабито);
			График.УстановитьЗначение(Точка, 1, Чемпионаты.КоличествоПропущено);
			
			Максимально = Макс(Максимально, Чемпионаты.КоличествоЗабито + Чемпионаты.КоличествоПропущено);
		КонецЦикла;
		
	ИначеЕсли ЗначениеЗаполнено(Отчет.Команда)
	И (ТипГрафика = 25 Или ТипГрафика = 26)
	Тогда
		Серия = График.УстановитьСерию(Отчет.Команда);
		Цвет	= Цвет(Отчет.Команда);
		Если ЗначениеЗаполнено(Цвет) Тогда
			Серия.Цвет				= Цвет;
		КонецЕсли;
		Пока Чемпионаты.Следующий() Цикл
			Точка = График.УстановитьТочку(ФорматЧГ(Чемпионаты.Точка));
			Точка.Расшифровка = Чемпионаты.Чемпионат;
			График.УстановитьЗначение(Точка, 0, ?(ТипГрафика = 25, Чемпионаты.КоличествоОчков, Чемпионаты.КоличествоГолов));
			
			Максимально = Макс(Максимально, ?(ТипГрафика = 25, Чемпионаты.КоличествоОчков, Чемпионаты.КоличествоГолов));
		КонецЦикла;
		
	Иначе
		Значения	= Новый Массив;
		Точки		= Новый Соответствие;
		Серии		= Новый Соответствие;
		
		Если ЗначениеЗаполнено(Отчет.Команда) Тогда
			ЗаполнитьЗначенияСвойств(Отчет.Данные.Добавить(), Новый Структура("Серия", Отчет.Команда));
			Пока Чемпионаты.Следующий() Цикл
				Если График.Точки.Количество() > 0 Тогда
				ИначеЕсли ТипГрафика = 0 И НЕ Чемпионаты.Пометка Тогда Продолжить;
				ИначеЕсли ТипГрафика = 2 И НЕ Чемпионаты.Пометка Тогда Продолжить;
				ИначеЕсли ТипГрафика = 3 И НЕ Чемпионаты.Пометка Тогда Продолжить;
				ИначеЕсли ТипГрафика = 4 И НЕ Чемпионаты.Пометка Тогда Продолжить;
				ИначеЕсли ТипГрафика = 9 И НЕ Чемпионаты.Пометка Тогда Продолжить;
				ИначеЕсли ТипГрафика = 10 И НЕ Чемпионаты.Пометка Тогда Продолжить;
				ИначеЕсли ТипГрафика = 11 И НЕ Чемпионаты.Пометка Тогда Продолжить;
				ИначеЕсли ТипГрафика = 24 И НЕ Чемпионаты.Пометка Тогда Продолжить;
				КонецЕсли;
				Точка = График.УстановитьТочку(ФорматЧГ(Чемпионаты.Точка));
				Точка.Расшифровка = Чемпионаты.Чемпионат;
				
				Точки.Вставить(Чемпионаты.Чемпионат, Точка);
			КонецЦикла;
		Иначе
			ЗначениеК	= ?(ТипГрафика <= 11 Или ТипГрафика >= 23, 2, 1);
			Пока Чемпионаты.Следующий() Цикл
				Значения.Очистить();
				Количество	= 0;
				
				Выборка	= Чемпионаты.Выбрать();
				Пока Выборка.Следующий() И Значения.Количество() < ЗначениеК Или Выборка.Количество = Количество Цикл
					Значения.Добавить(Выборка.Количество);
					Количество = Выборка.Количество;
					
					Если Отчет.Данные.НайтиСтроки(Новый Структура("Серия", Выборка.Серия)).Количество() = 0 Тогда
						ЗаполнитьЗначенияСвойств(Отчет.Данные.Добавить(), Выборка);
					КонецЕсли;
					Точка	= Точки.Получить(Выборка.Чемпионат);
					Если Точка = Неопределено Тогда
						Точка = График.УстановитьТочку(ФорматЧГ(Выборка.Точка));
						Точка.Расшифровка = Выборка.Чемпионат;
						
						Точки.Вставить(Выборка.Чемпионат, Точка);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Отчет.Данные.Сортировать("Серия");
		КонецЕсли;
		
		Для Каждого ТекСтрока Из Отчет.Данные Цикл
			Серия = График.УстановитьСерию(ТекСтрока.Серия);
			Цвет	= Цвет(ТекСтрока.Серия);
			Если ЗначениеЗаполнено(Цвет) Тогда
				Серия.Цвет				= Цвет;
				Серия.ПриоритетЦвета	= Истина;
			КонецЕсли;
			Серия.Расшифровка	= ТекСтрока.Серия;
			
			Серии.Вставить(ТекСтрока.Серия, Серия);
		КонецЦикла;
		
		Чемпионаты.Сбросить();
		Пока Чемпионаты.Следующий() Цикл
			Количество	= 0;
			Выборка	= Чемпионаты.Выбрать();
			Пока Выборка.Следующий() Цикл
				Количество	= Количество + 1;
				Серия	= Серии.Получить(Выборка.Серия);
				Если Серия = Неопределено Тогда Продолжить;
				КонецЕсли;
				
				График.УстановитьЗначение(Точки.Получить(Выборка.Чемпионат), Серия, ?(ТипГрафика = 24, Количество, Выборка.Количество));
				
				Максимально = Макс(Максимально, ?(ТипГрафика = 24, Количество, Выборка.Количество));
				
				Если ЗначениеЗаполнено(Отчет.Команда) Тогда Прервать; КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	График.ОсьЗначений.МаксимальноеЗначение = ?(Максимально <= 40, Максимально, ?(ТипГрафика = 30, Окр(Максимально + 500, -3), Окр(Максимально + 5, -1)));
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда=Неопределено)
	Если ПроверитьЗаполнение() Тогда
		ГрафикОбновить();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЛигиЗагрузить()
	//Лиги.Очистить();
	//Элементы.Лига.СписокВыбора.Очистить();
	Запрос	= Новый Запрос("ВЫБРАТЬ
	      	               |	ТурнирнаяТаблица.Тур.Владелец.Владелец КАК Ссылка
	      	               |ИЗ
	      	               |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
	      	               |ГДЕ
	      	               |	ТурнирнаяТаблица.Тур.Владелец.Владелец.ОлимпийскаяСистема = ЛОЖЬ
	      	               |
	      	               |СГРУППИРОВАТЬ ПО
	      	               |	ТурнирнаяТаблица.Тур.Владелец.Владелец
	      	               |
	      	               |УПОРЯДОЧИТЬ ПО
	      	               |	МАКСИМУМ(ТурнирнаяТаблица.Период) УБЫВ");
	Выборка	= Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Элементы.Лига.СписокВыбора.Количество() < 11 Тогда
			Элементы.Лига.СписокВыбора.Добавить(Выборка.Ссылка);
		КонецЕсли;
		Лиги.Добавить(Выборка.Ссылка);
	КонецЦикла;
	ОбщегоНазначения.КартинкиЗагрузить(Элементы.Лига.СписокВыбора);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЛигиЗагрузить();
	Если Параметры.Свойство("Лига") Тогда
		Отчет.Лига	= Параметры.Лига;
		ОбщегоНазначения.ЗаголовокСкрыть(ЭтаФорма, Элементы.Лига);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ЗначениеЗаполнено(Отчет.Лига) Тогда
		Лига = МояЛига();
		Если Лиги.НайтиПоЗначению(Лига) <> Неопределено Тогда
			Отчет.Лига = Лига;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Отчет.Лига) Тогда
		КлубыЗагрузить();
	КонецЕсли;
	ТипГрафикаЗагрузить();
	Сформировать();
КонецПроцедуры

&НаКлиенте
Процедура ГрафикОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	Если ТипЗнч(Расшифровка) = Тип("СправочникСсылка.Чемпионаты") Тогда
		СтандартнаяОбработка = Ложь;
		
		Форма = ПолучитьФорму("Отчет.ТурнирнаяТаблица.Форма");
		Форма.АвтоматическоеСохранениеДанныхВНастройках = АвтоматическоеСохранениеДанныхФормыВНастройках.НеИспользовать;
		Форма.Отчет.Чемпионат = Расшифровка;
		Если Форма.Открыта() Тогда
			Форма.КомандаСформировать();
		КонецЕсли;
		Форма.Открыть();
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("СправочникСсылка.Команды")
	И НЕ ЗначениеЗаполнено(Отчет.Команда)
	Тогда
		СтандартнаяОбработка = Ложь;
		
		Отчет.Команда = Расшифровка;
		Сформировать();
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция МояЛига()
	Возврат СерверныйФункции.Лига(СерверныйФункции.ЧемпионатПолучитьПоследнее());
КонецФункции

&НаКлиенте
Процедура КомандаОчистка(Элемент, СтандартнаяОбработка)
	Клубы.Очистить();
	
	ТипГрафикаЗагрузить();
	ГрафикОбновить();
КонецПроцедуры

&НаСервереБезКонтекста
Функция КлубыПолучить(Лига)
	Запрос	= Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 21
	      	               |	ТурнирнаяТаблица.Тур.Владелец КАК Чемпионат
	      	               |ПОМЕСТИТЬ Чемпионаты
	      	               |ИЗ
	      	               |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
	      	               |ГДЕ
	      	               |	ТурнирнаяТаблица.Тур.Владелец.Владелец = &Лига
	      	               |
	      	               |СГРУППИРОВАТЬ ПО
	      	               |	ТурнирнаяТаблица.Тур.Владелец,
	      	               |	ГОД(ТурнирнаяТаблица.Тур.Владелец.ДатаОкончания)
	      	               |
	      	               |ИМЕЮЩИЕ
	      	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТурнирнаяТаблица.Регистратор) >= 0.62 * КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТурнирнаяТаблица.Команда) * КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТурнирнаяТаблица.Команда)
	      	               |
	      	               |УПОРЯДОЧИТЬ ПО
	      	               |	ГОД(ТурнирнаяТаблица.Тур.Владелец.ДатаОкончания) УБЫВ
	      	               |;
	      	               |
	      	               |////////////////////////////////////////////////////////////////////////////////
	      	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	      	               |	ТурнирнаяТаблица.Команда КАК Команда
	      	               |ИЗ
	      	               |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
	      	               |ГДЕ
	      	               |	ТурнирнаяТаблица.Тур.Владелец В
	      	               |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	      	               |				Чемпионаты.Чемпионат
	      	               |			ИЗ
	      	               |				Чемпионаты)");
	Запрос.УстановитьПараметр("Лига",			Лига);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
КонецФункции

&НаКлиенте
Процедура КомандаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка	= Ложь;
	Если ЗначениеЗаполнено(Отчет.Лига) Тогда
		Если Клубы.Количество() = 0 Тогда
			мКоманды = КлубыПолучить(Отчет.Лига);
			//КлубыЗагрузить(мКоманды);
		Иначе
			мКоманды = Клубы.ВыгрузитьЗначения();
		КонецЕсли;
		НаКлиенте.ОбработкаКомандыОткрытьФорму("Справочник.Команды.ФормаВыбора", Новый Структура("Отбор", Новый Структура("Ссылка", мКоманды)), Элемент);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КлубыЗагрузить(мКоманды=Неопределено)
	Если Клубы.Количество() = 0 Или ТипЗнч(мКоманды) = Тип("Массив") Тогда
		Если мКоманды = Неопределено Тогда мКоманды = КлубыПолучить(Отчет.Лига); КонецЕсли;
		Клубы.ЗагрузитьЗначения(мКоманды);
		Элементы.Команда.СписокВыбора.ЗагрузитьЗначения(СерверныйФункции.КомандыЛиги(Отчет.Лига, Истина));
		ПодключитьОбработчикОжидания("КартинкиЗагрузить", 0.1, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЛигаПриИзменении(Элемент)
	Отчет.Команда = Неопределено;
	Клубы.Очистить();
	КлубыЗагрузить();
	ГрафикОбновить();
КонецПроцедуры

&НаКлиенте
Процедура КартинкиЗагрузить() Экспорт
	ОбщегоНазначения.КартинкиЗагрузить(Элементы.Команда.СписокВыбора, Кеш);
КонецПроцедуры

&НаКлиенте
Процедура КомандаПриИзменении(Элемент)
	ТипГрафикаЗагрузить();
	ГрафикОбновить();
КонецПроцедуры

&НаКлиенте
Процедура ТипГрафикаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ТипГрафикаЗагрузить();
КонецПроцедуры

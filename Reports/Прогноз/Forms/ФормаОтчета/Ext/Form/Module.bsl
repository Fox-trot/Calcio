&НаСервере
Функция МатчиПолучить(Команда, Проведен)
	Матчи = Новый СписокЗначений;
	Если Проведен Тогда
		Запрос	= Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 11
	      	               |	ТурнирнаяТаблица.Регистратор КАК Значение
	      	               |ИЗ
	      	               |	РегистрНакопления.ТурнирнаяТаблица КАК ТурнирнаяТаблица
	      	               |ГДЕ
	      	               |	ТурнирнаяТаблица.Команда = &Команда
	      	               |	И ТурнирнаяТаблица.Тур.Владелец = &Чемпионат
	      	               |
	      	               |УПОРЯДОЧИТЬ ПО
	      	               |	ТурнирнаяТаблица.Период УБЫВ");
		Запрос.УстановитьПараметр("Чемпионат",	Отчет.Чемпионат);
		Запрос.УстановитьПараметр("Команда",	Команда);
		Матчи.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0));
	Иначе
		Для Каждого ТекСтрока Из Отчет.Фазы Цикл
			Если Матчи.Количество() = 11 Тогда
				Прервать;
			ИначеЕсли ТекСтрока.Команда = Команда Или ТекСтрока.Противник = Команда Тогда
				Матчи.Добавить(ТекСтрока.Матч, СтрШаблон("%1	%2 - %3", ТекСтрока.Матч, ТекСтрока.Фаза, ТекСтрока.ФазаП));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Матчи;
КонецФункции

&НаКлиенте
Процедура ЧемпионатНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ПараметрКоманды = Новый Структура("РежимВыбора,Отбор,ТолькоТекущие", Истина, Новый Структура("Ссылка", Чемпионаты.ВыгрузитьЗначения()), Истина);
	Если ЗначениеЗаполнено(Отчет.Чемпионат) Тогда
		ПараметрКоманды.Вставить("ТекущаяСтрока", Отчет.Чемпионат);
	КонецЕсли;
	НаКлиенте.ОбработкаКомандыОткрытьФорму("Справочник.Чемпионаты.ФормаВыбора", ПараметрКоманды, Элемент, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ФазыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	НаКлиенте.Показать(Элемент.ТекущиеДанные.Матч, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ДиаграммаВыбор(Элемент, Значения, СтандартнаяОбработка, Дата)
	Если ТипЗнч(Значения) = Тип("Массив") Тогда
		СтандартнаяОбработка = Ложь;
		Для Каждого Значение Из Значения Цикл
			Если ТипЗнч(Значение.Расшифровка) = Тип("Структура") Тогда
				ОбработкаРасшифровки(Значение.Расшифровка);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ОбработкаРасшифровки(Значения.Значение, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры
